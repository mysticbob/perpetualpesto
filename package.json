{
  "name": "recipe-planner",
  "version": "1.0.0",
  "description": "Recipe extraction and meal planning app",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:db\" \"bun run wait-for-db && bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun run server/index.ts",
    "dev:db": "docker-compose up -d",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "bun run server/index.ts",
    "server": "bun run server/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d && bun run wait-for-db && bun run db:push",
    "db:optimize": "bun run scripts/optimize-db.ts",
    "setup": "bun install && bun run db:up && bun run scripts/wait-for-db.ts && bun run db:push && bun run db:generate",
    "setup:fresh": "bun run db:reset && bun run db:push && bun run db:generate && bun run db:optimize",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "bun run scripts/performance-test.ts",
    "wait-for-db": "bun run scripts/wait-for-db.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hono/node-server": "^1.19.6",
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.2",
    "cheerio": "^1.0.0-rc.12",
    "compressorjs": "^1.2.1",
    "concurrently": "^9.2.1",
    "convert": "^5.13.1",
    "culinary-unit-abbreviation": "^1.1.0",
    "firebase": "^12.6.0",
    "fraction.js": "^5.3.4",
    "framer-motion": "^12.23.24",
    "hono": "^4.10.6",
    "openai": "^6.9.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "react-webcam": "^7.2.0",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
