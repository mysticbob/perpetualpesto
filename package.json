{
  "name": "recipe-planner",
  "version": "1.0.0",
  "description": "Recipe extraction and meal planning app",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:db\" \"bun run wait-for-db && bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun run server/index.ts",
    "dev:db": "docker-compose up -d",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "bun run server/index.ts",
    "server": "bun run server/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d && bun run wait-for-db && bun run db:push",
    "db:optimize": "bun run scripts/optimize-db.ts",
    "setup": "bun install && bun run db:up && bun run scripts/wait-for-db.ts && bun run db:push && bun run db:generate",
    "setup:fresh": "bun run db:reset && bun run db:push && bun run db:generate && bun run db:optimize",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "bun run scripts/performance-test.ts",
    "wait-for-db": "bun run scripts/wait-for-db.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"server/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"server/**/*.{ts,js}\""
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "^1.19.6",
    "@prisma/client": "^6.19.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "compressorjs": "^1.2.1",
    "concurrently": "^9.2.1",
    "convert": "^5.13.1",
    "culinary-unit-abbreviation": "^1.1.0",
    "firebase": "^12.5.0",
    "fraction.js": "^5.3.4",
    "framer-motion": "^12.23.24",
    "hono": "^4.10.4",
    "openai": "^6.8.1",
    "prisma": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "react-webcam": "^7.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.12",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.4"
  }
}
