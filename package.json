{
  "name": "recipe-planner",
  "version": "1.0.0",
  "description": "Recipe extraction and meal planning app",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:db\" \"bun run wait-for-db && bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun run server/index.ts",
    "dev:db": "docker-compose up -d",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "bun run server/index.ts",
    "server": "bun run server/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d && bun run wait-for-db && bun run db:push",
    "db:optimize": "bun run scripts/optimize-db.ts",
    "setup": "bun install && bun run db:up && bun run scripts/wait-for-db.ts && bun run db:push && bun run db:generate",
    "setup:fresh": "bun run db:reset && bun run db:push && bun run db:generate && bun run db:optimize",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:watch": "vitest watch",
    "test:performance": "bun run scripts/performance-test.ts",
    "promptfoo:eval": "npx promptfoo eval -c promptfoo/configs/recipe-suggestions.yaml",
    "promptfoo:eval:intent": "npx promptfoo eval -c promptfoo/configs/command-intent.yaml",
    "promptfoo:eval:all": "bun run promptfoo:eval && bun run promptfoo:eval:intent",
    "promptfoo:view": "npx promptfoo view",
    "playwright:install": "npx playwright install --with-deps",
    "wait-for-db": "bun run scripts/wait-for-db.ts"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hono/node-server": "^1.5.0",
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "compressorjs": "^1.2.1",
    "concurrently": "^8.2.2",
    "convert": "^5.12.0",
    "culinary-unit-abbreviation": "^1.1.0",
    "firebase": "^10.7.1",
    "fraction.js": "^5.2.2",
    "framer-motion": "^10.16.4",
    "hono": "^3.11.7",
    "openai": "^5.15.0",
    "prisma": "^5.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "react-webcam": "^7.2.0",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "msw": "^2.12.2",
    "promptfoo": "^0.119.6",
    "supertest": "^7.1.4",
    "tiktoken": "^1.0.22",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^3.2.4",
    "zod": "^4.1.12"
  }
}
