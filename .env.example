# Database Configuration
# PostgreSQL connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://recipe_user:recipe_password@localhost:5433/recipe_planner"

# Server Configuration
PORT=3003
NODE_ENV="development"

# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
FIREBASE_PROJECT_ID="your_project_id"

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key"
OPENAI_ORG_ID="" # Optional: Your OpenAI organization ID

# AI Model Configuration
# Use latest model names from OpenAI documentation
AI_MODEL_CHAT="gpt-4-turbo-preview"
AI_MODEL_VISION="gpt-4-vision-preview"
AI_MODEL_EMBEDDING="text-embedding-3-small"

# AI Rate Limiting (requests per hour)
AI_CHAT_RATE_LIMIT="100"
AI_VISION_RATE_LIMIT="50"
AI_CHAT_TOKEN_LIMIT="50000"
AI_VISION_TOKEN_LIMIT="100000"

# AI Feature Flags
AI_FEATURES_ENABLED="true"
AI_CACHE_ENABLED="true"
AI_CACHE_TTL="300" # Cache TTL in seconds
AI_RETRY_ENABLED="true"
AI_LOGGING_ENABLED="true"

# Security Configuration
# Set to "true" in production
SECURE_COOKIES="false"
# Session secret - CHANGE THIS in production!
SESSION_SECRET="change_this_to_a_random_string_in_production"

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3003"