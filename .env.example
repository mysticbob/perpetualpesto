DATABASE_URL="postgresql://recipe_user:recipe_password@localhost:5433/recipe_planner"
PORT=3003
NODE_ENV="development"

# Firebase Configuration
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
FIREBASE_PROJECT_ID="your_project_id"

# OpenAI Configuration
OPENAI_API_KEY="your_openai_api_key"
OPENAI_ORG_ID="your_openai_org_id_optional"

# AI Model Configuration
AI_MODEL_CHAT="gpt-4o"
AI_MODEL_VISION="gpt-4o"
AI_MODEL_EMBEDDING="text-embedding-3-small"

# AI Rate Limiting (requests per hour)
AI_CHAT_RATE_LIMIT="100"
AI_VISION_RATE_LIMIT="50"
AI_CHAT_TOKEN_LIMIT="50000"
AI_VISION_TOKEN_LIMIT="100000"

# AI Feature Flags
AI_FEATURES_ENABLED="true"
AI_CACHE_ENABLED="true"
AI_CACHE_TTL="300"
AI_RETRY_ENABLED="true"
AI_LOGGING_ENABLED="true"

# Redis Configuration (Performance Caching)
REDIS_ENABLED="true"
REDIS_URL="redis://localhost:6379"
REDIS_TTL="300"

# Performance & Caching
ENABLE_COMPRESSION="true"
ENABLE_RESPONSE_CACHE="true"
CACHE_MAX_AGE="300"

# Database Connection Pooling
DB_POOL_MIN="2"
DB_POOL_MAX="10"
DB_CONNECTION_TIMEOUT="30000"

# Build & Runtime Optimization
VITE_API_URL="http://localhost:3001"
VITE_ENABLE_PWA="true"