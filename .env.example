# =============================================================================
# INFISICAL CONFIGURATION (Recommended for Production)
# =============================================================================
# To use Infisical for secrets management, set the following variables:
# INFISICAL_CLIENT_ID="your_infisical_client_id"
# INFISICAL_CLIENT_SECRET="your_infisical_client_secret"
# INFISICAL_PROJECT_ID="your_infisical_project_id"
# INFISICAL_ENVIRONMENT="dev" # or "staging", "production"
# INFISICAL_SECRETS_PATH="/" # Path to secrets in Infisical

# When Infisical is configured, all secrets below will be fetched from Infisical.
# If Infisical is not configured, the application will fall back to these environment variables.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://recipe_user:recipe_password@localhost:5433/recipe_planner"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3003

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
FIREBASE_PROJECT_ID="your_project_id"

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
OPENAI_API_KEY="your_openai_api_key"
OPENAI_ORG_ID="" # Optional: Your OpenAI organization ID

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
AI_MODEL_CHAT="gpt-4-turbo-preview"
AI_MODEL_VISION="gpt-4-vision-preview"
AI_MODEL_EMBEDDING="text-embedding-3-small"

# =============================================================================
# AI RATE LIMITING (requests per hour)
# =============================================================================
AI_CHAT_RATE_LIMIT="100"
AI_VISION_RATE_LIMIT="50"
AI_CHAT_TOKEN_LIMIT="50000"
AI_VISION_TOKEN_LIMIT="100000"

# =============================================================================
# AI FEATURE FLAGS
# =============================================================================
AI_FEATURES_ENABLED="true"
AI_CACHE_ENABLED="true"
AI_CACHE_TTL="300" # Cache TTL in seconds
AI_RETRY_ENABLED="true"
AI_LOGGING_ENABLED="true"

# Security Configuration
# Set to "true" in production
SECURE_COOKIES="false"
# Session secret - CHANGE THIS in production!
SESSION_SECRET="change_this_to_a_random_string_in_production"

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3003"