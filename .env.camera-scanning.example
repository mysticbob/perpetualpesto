# ============================================================================
# Camera Scanning Environment Variables
# ============================================================================
# Copy relevant sections to your .env file and fill in your API keys

# ----------------------------------------------------------------------------
# Vision API Keys
# ----------------------------------------------------------------------------

# OpenAI (Already configured - GPT-4 Vision)
OPENAI_API_KEY=sk-...

# Anthropic Claude 3.5 Sonnet
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud (Gemini 1.5 Pro & Flash)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./google-cloud-key.json
# Alternative: Use API key instead of service account
# GOOGLE_API_KEY=AIza...

# Azure Computer Vision (Optional)
AZURE_VISION_KEY=...
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Clarifai (Optional)
CLARIFAI_API_KEY=...
CLARIFAI_USER_ID=...
CLARIFAI_APP_ID=...

# ----------------------------------------------------------------------------
# Camera Scanning Configuration
# ----------------------------------------------------------------------------

# Default provider to use (options: gpt-4-vision, claude-3.5-sonnet, gemini-1.5-pro, gemini-1.5-flash)
CAMERA_SCANNING_DEFAULT_PROVIDER=gemini-1.5-pro

# Enable A/B testing across providers
CAMERA_SCANNING_ENABLE_AB_TEST=true

# Confidence threshold for auto-adding items (0.0 to 1.0)
CAMERA_SCANNING_CONFIDENCE_THRESHOLD=0.75

# Enable duplicate detection when adding scanned items
CAMERA_SCANNING_ENABLE_DUPLICATE_DETECTION=true

# Max image size in bytes (default: 5MB)
CAMERA_SCANNING_MAX_IMAGE_SIZE=5242880

# Image compression quality (0.0 to 1.0)
CAMERA_SCANNING_IMAGE_QUALITY=0.9

# ----------------------------------------------------------------------------
# A/B Testing Weights (must sum to 1.0)
# ----------------------------------------------------------------------------

AB_TEST_WEIGHT_GPT4_VISION=0.20
AB_TEST_WEIGHT_CLAUDE_35=0.20
AB_TEST_WEIGHT_GEMINI_PRO=0.30
AB_TEST_WEIGHT_GEMINI_FLASH=0.20
AB_TEST_WEIGHT_AZURE_CV=0.10

# Number of scans before assigning user to best provider
AB_TEST_MIN_SCANS_BEFORE_ASSIGNMENT=10

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------

# Max scans per user per hour
CAMERA_SCANNING_RATE_LIMIT_PER_HOUR=100

# Max scans per user per day
CAMERA_SCANNING_RATE_LIMIT_PER_DAY=500

# ----------------------------------------------------------------------------
# Cost Management
# ----------------------------------------------------------------------------

# Alert when user's monthly cost exceeds this amount (USD)
CAMERA_SCANNING_COST_ALERT_THRESHOLD=10.00

# Max cost per user per month (USD) - block after exceeding
CAMERA_SCANNING_MAX_COST_PER_MONTH=50.00

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

# Enable continuous video scanning mode
CAMERA_SCANNING_ENABLE_CONTINUOUS_MODE=false

# Enable nutrition extraction
CAMERA_SCANNING_ENABLE_NUTRITION=true

# Enable expiry date OCR
CAMERA_SCANNING_ENABLE_EXPIRY_DATES=true

# Enable smart provider routing (Flash -> Pro for low confidence)
CAMERA_SCANNING_ENABLE_SMART_ROUTING=true

# ----------------------------------------------------------------------------
# Evaluation & Testing
# ----------------------------------------------------------------------------

# Path to evaluation dataset
EVALUATION_DATASET_PATH=./test-images/ground-truth

# Minimum accuracy threshold for provider activation
EVALUATION_MIN_ACCURACY=0.85

# Run evaluation on deploy
EVALUATION_RUN_ON_DEPLOY=false

# ----------------------------------------------------------------------------
# Logging & Monitoring
# ----------------------------------------------------------------------------

# Log all scan results for debugging
CAMERA_SCANNING_LOG_RESULTS=true

# Log provider performance metrics
CAMERA_SCANNING_LOG_PERFORMANCE=true

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://...
